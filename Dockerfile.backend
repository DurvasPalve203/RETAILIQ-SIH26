FROM python:3.10-slim

WORKDIR /app

# Install system dependencies for OpenCV, SQLite, curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    sqlite3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user setup
RUN useradd -m -u 1000 retailiq && \
    mkdir -p /app/backend/data/gallery /app/backend/data/baselines /app/backend/data/logs && \
    chown -R retailiq:retailiq /app

COPY backend/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN chown -R retailiq:retailiq /app

USER retailiq

ENV PYTHONPATH=.
ENV RETAILIQ_CONFIG=config.yaml
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

CMD ["python", "backend/main.py"]
