# RetailIQ Environment Configuration Specification
# Profile: development | staging | production
RETAILIQ_ENV=development

# Edge Device Identification
NODE_ID=edge-store-01
STORE_NAME=Apex Retail - Bay Area Express
LOCATION=Aisle 4 & Checkout Zone
HARDWARE_TARGET=edge_offline

# Video Capture Configuration
# IP Webcam default e.g. "http://192.168.1.14:8080/video" or USB webcam index "0" or "synthetic"
CAMERA_SOURCE=http://192.168.1.14:8080/video
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_TARGET_FPS=8
CAMERA_ROTATION_DEG=0

# Detection & Tracking Thresholds
DETECTOR_CONFIDENCE_THRESHOLD=0.45
SKU_SIMILARITY_THRESHOLD=0.72

# Database & Storage
DATABASE_PATH=backend/data/retailiq.db
SEED_DB_ON_STARTUP=false

# Sync & MQTT Broker
MQTT_ENABLED=false
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=retailiq/stores/store-01

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","*"]
ADMIN_API_KEY=retailiq-edge-admin-secret
RATE_LIMIT_PER_MINUTE=120

# Hardware & Alert Subsystem
BUZZER_ENABLED=true
RGB_LED_ENABLED=true
SMS_ENABLED=true
SMS_UART_PORT=COM3
SMS_UART_BAUDRATE=9600
STORE_MANAGER_PHONE=+1-800-555-0199
